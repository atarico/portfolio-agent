# Copy to .env.local (Next.js loads it from apps/web).

# LLM provider: "google" (default) or "groq". Both have free tiers.
LLM_PROVIDER=google

# Optional: override the default model id for the selected provider
# (see PROVIDER_REGISTRY in src/lib/llm/provider.ts for the defaults).
# LLM_MODEL=

# Google AI Studio key (free, no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq key (free): https://console.groq.com/keys
GROQ_API_KEY=

# GitHub user whose portfolio the agent describes. Server configuration only:
# callers cannot pick another owner. Defaults to "atarico" when unset.
GITHUB_OWNER=atarico

# Optional. Unauthenticated GitHub API calls are limited to 60/hour per IP.
# A classic token with NO scopes (public data only) raises that to 5,000/hour.
# Never put a token with repo scope here: /api/mcp would serve private files.
GITHUB_TOKEN=

# Require "Authorization: Bearer <token>" on /api/mcp.
# Required in production: when NODE_ENV=production and this is unset, /api/mcp
# refuses every request with 503 instead of serving unauthenticated callers.
# Outside production it may stay empty, which keeps the endpoint open for local
# MCP clients (fine while GITHUB_TOKEN has no scopes).
MCP_AUTH_TOKEN=

# Optional. Trust `x-forwarded-for`/`x-real-ip` for rate-limit identity.
# Only meaningful on a platform that rewrites these headers at its edge for
# direct traffic (e.g. Vercel) -- off-platform they are attacker-controlled.
# Leave unset elsewhere: every caller then shares one rate-limit bucket.
# TRUST_PROXY_HEADERS=1

# Optional. By default the chat agent talks to the MCP server in-process.
# Set this to point the agent at any remote MCP server instead
# (absolute http(s) URL). MCP_SERVER_AUTHORIZATION is sent as the
# Authorization header value when set, e.g. "Bearer <token>".
# MCP_SERVER_URL=https://example.com/api/mcp
# MCP_SERVER_AUTHORIZATION=
